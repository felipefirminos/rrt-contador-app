# Anthropic API key — required for the LLM Q&A page (/chat).
# Generate at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model — defaults to claude-opus-4-7. Override to test against Sonnet/Haiku.
ANTHROPIC_MODEL=claude-opus-4-7

# API binding (changing requires also updating CORS_ORIGIN below if needed)
API_HOST=127.0.0.1
API_PORT=8765

# Streamlit origin allowed by CORS
CORS_ORIGIN=http://localhost:8501
